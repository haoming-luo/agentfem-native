{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentfem.org/schemas/native/kernel-result-0.1.schema.json",
  "title": "AgentFEM Native Kernel Result 0.1",
  "type": "object",
  "required": ["contract", "contract_version", "request_id", "status", "backend"],
  "properties": {
    "contract": {"const": "agentfem.native-kernel-request"},
    "contract_version": {"const": "0.1.0"},
    "request_id": {"type": "string"},
    "status": {"enum": ["success", "failed"]},
    "backend": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"const": "native"}, "version": {"type": "string"}},
      "additionalProperties": false
    },
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "quantities": {"type": "object", "additionalProperties": {"type": "number"}},
    "fields": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "runtime": {"type": "object"},
    "warnings": {"type": "array"},
    "error": {
      "type": "object",
      "required": ["code", "message", "path"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {"required": ["capabilities", "quantities", "fields", "artifacts", "runtime", "warnings"]},
      "else": {"required": ["error"]}
    }
  ],
  "additionalProperties": false
}
